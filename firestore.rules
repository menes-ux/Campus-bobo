rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isStudent() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function hasCampusProfile() {
      return isStudent()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['student', 'staff'];
    }

    match /users/{userId} {
      allow get: if isVerified() && request.auth.uid == userId;

      allow create: if isStudent()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time;

      allow list, update, delete: if false;
    }

    match /incidents/{incidentId} {
      allow get, list: if hasCampusProfile();

      allow create: if hasCampusProfile()
        && request.resource.data.keys().hasAll(['reportedBy', 'title', 'description', 'location', 'category', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['reportedBy', 'title', 'description', 'location', 'category', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 120
        && request.resource.data.category in ['facilities', 'water', 'electricity', 'furniture', 'sanitation', 'safety']
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
