rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isStudent() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function hasCampusProfile() {
      return isStudent()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['student', 'staff'];
    }

    function isStaff() {
      return hasCampusProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function validIncident(data, incidentId) {
      return data.keys().hasAll(['reportedBy', 'title', 'description', 'location', 'category', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['reportedBy', 'title', 'description', 'location', 'category', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.location is string && data.location.size() >= 3 && data.location.size() <= 120
        && data.category in ['facilities', 'water', 'electricity', 'furniture', 'sanitation', 'safety']
        && data.status in ['submitted', 'in_progress', 'resolved']
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isVerified() && request.auth.uid == userId;

      allow create: if isStudent()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time;

      allow list, update, delete: if false;
    }

    match /incidents/{incidentId} {
      allow get, list: if hasCampusProfile();

      allow create: if hasCampusProfile()
        && validIncident(request.resource.data, incidentId)
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time;

      allow update: if hasCampusProfile()
        && validIncident(request.resource.data, incidentId)
        && (
          (resource.data.reportedBy == request.auth.uid
            && resource.data.status == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'location', 'category', 'updatedAt']))
          || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && ((resource.data.status == 'submitted' && request.resource.data.status == 'in_progress')
              || (resource.data.status == 'in_progress' && request.resource.data.status == 'resolved')))
        );

      allow delete: if hasCampusProfile()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'submitted';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
